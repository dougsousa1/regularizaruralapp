 municipal nº","grupo":"Imóvel","tipo":"texto"},"imovel_cl":{"rotulo":"C.L.","grupo":"Imóvel","tipo":"texto"},"aquisicao_ano":{"rotulo":"Ano da escritura de aquisição","grupo":"Aquisição anterior","tipo":"texto"},"aquisicao_oficio":{"rotulo":"Ofício de Notas da aquisição","grupo":"Aquisição anterior","tipo":"texto"},"aquisicao_comarca":{"rotulo":"Comarca","grupo":"Aquisição anterior","tipo":"texto"},"aquisicao_livro":{"rotulo":"Livro nº","grupo":"Aquisição anterior","tipo":"texto"},"aquisicao_folhas":{"rotulo":"Folhas","grupo":"Aquisição anterior","tipo":"texto"},"valor":{"rotulo":"Valor atribuído à doação","grupo":"Valor","tipo":"moeda"},"valor_benfeitorias":{"rotulo":"Valor das benfeitorias","grupo":"Valor","tipo":"moeda"},"substituto_tabeliao_nome":{"rotulo":"Substituto(a) do tabelião","grupo":"Cartório","tipo":"texto"}},"duvidas":["P43: só o ano da data “__/__/___” da escritura de aquisição está marcado","P50: assumido que o escrevente do encerramento é o mesmo da abertura (P10)","P40: “Prefeitura Municipal do Estado do [...]” — interpretado como UF/município da inscrição"],"origem":"Escritura--Doação.docx","doc":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":"left","recuo":4},"content":[{"type":"text","text":"ESCRITURA DE DOAÇÃO, ","marks":[{"type":"bold"}]},{"type":"text","text":"na forma abaixo:"}]},{"type":"paragraph","attrs":{"textAlign":"left"},"content":[{"type":"text","text":"        ","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"                                                S A I B A M ","marks":[{"type":"bold"}]},{"type":"text","text":"- quantos esta pública escritura virem que aos ("},{"type":"campo","attrs":{"chave":"data_dia"}},{"type":"text","text":") dias do mês de "},{"type":"campo","attrs":{"chave":"data_mes"}},{"type":"text","text":", do ano Dois Mil e "},{"type":"campo","attrs":{"chave":"data_ano"}},{"type":"text","text":" - (2"},{"type":"campo","attrs":{"chave":"data_ano_digitos"}},{"type":"text","text":"), nesta cidade "},{"type":"campo","attrs":{"chave":"local"}},{"type":"text","text":", Estado "},{"type":"campo","attrs":{"chave":"uf"}},{"type":"text","text":", neste Cartório "},{"type":"campo","attrs":{"chave":"cartorio_oficio"}},{"type":"text","text":" do Ofício de Notas, da Cidade "},{"type":"campo","attrs":{"chave":"cartorio_cidade"}},{"type":"text","text":", situado na "},{"type":"campo","attrs":{"chave":"cartorio_endereco"}},{"type":"text","text":", e perante mim, "},{"type":"campo","attrs":{"chave":"escrevente_nome"},"marks":[{"type":"bold"}]},{"type":"text","text":", Escrevente, conforme Lei nº. 8935 de 18.11.94 e publicada no D.O. em 21.11.94, compareceram as partes entre si, justas e contratadas, a saber: de um lado, como "},{"type":"text","text":"OUTORGANTE (S) DOADOR (ES):","marks":[{"type":"bold"}]},{"type":"text","text":" "},{"type":"campo","attrs":{"chave":"doador_nome"},"marks":[{"type":"bold"}]},{"type":"text","text":", (nacionalidade), (profissão), (filiação), e-mail "},{"type":"campo","attrs":{"chave":"doador_email"}},{"type":"text","text":", portador (a) da Carteira Nacional de Habilitação (CNH) n° "},{"type":"campo","attrs":{"chave":"doador_cnh"}},{"type":"text","text":", expedida pelo "},{"type":"campo","attrs":{"chave":"doador_cnh_orgao"}},{"type":"text","text":" em "},{"type":"campo","attrs":{"chave":"doador_cnh_data"}},{"type":"text","text":", inscrito no CPF sob o n° "},{"type":"campo","attrs":{"chave":"doador_cpf"}},{"type":"text","text":" (estado civil) pelo (regime), na vigência da Lei "},{"type":"campo","attrs":{"chave":"doador_regime_lei"}},{"type":"text","text":", com "},{"type":"campo","attrs":{"chave":"doador_conjuge_nome"},"marks":[{"type":"bold"}]},{"type":"text","text":", (nacionalidade), (profissão), (filiação), portador(a) da Carteira Nacional de Habilitação (CNH) n° "},{"type":"campo","attrs":{"chave":"doador_conjuge_cnh"}},{"type":"text","text":", expedida pelo "},{"type":"campo","attrs":{"chave":"doador_conjuge_cnh_orgao"}},{"type":"text","text":" em "},{"type":"campo","attrs":{"chave":"doador_conjuge_cnh_data"}},{"type":"text","text":", inscrita no CPF sob o nº "},{"type":"campo","attrs":{"chave":"doador_conjuge_cpf"}},{"type":"text","text":", ambos* residente (s) e domiciliado (a) (s) nesta cidade, (endereço completo), doravante denominado (s) simplesmente "},{"type":"text","text":"“DOADOR (ES)”","marks":[{"type":"bold"}]},{"type":"text","text":"; e de outro lado, como "},{"type":"text","text":"OUTORGADA DONATÁRIO (A)","marks":[{"type":"bold"}]},{"type":"text","text":", "},{"type":"campo","attrs":{"chave":"donatario_nome"},"marks":[{"type":"bold"}]},{"type":"text","text":", ","marks":[{"type":"bold"}]},{"type":"text","text":"(nacionalidade), (profissão), (filiação), e-mail "},{"type":"campo","attrs":{"chave":"donatario_email"}},{"type":"text","text":" , portador (a) da Carteira Nacional de Habilitação (CNH) n° "},{"type":"campo","attrs":{"chave":"donatario_cnh"}},{"type":"text","text":", expedida pelo (órgão) em "},{"type":"campo","attrs":{"chave":"donatario_cnh_data"}},{"type":"text","text":", inscrito no CPF sob nº "},{"type":"campo","attrs":{"chave":"donatario_cpf"}},{"type":"text","text":", (estado civil/regime) na vigência da Lei "},{"type":"campo","attrs":{"chave":"donatario_regime_lei"}},{"type":"text","text":", com "},{"type":"campo","attrs":{"chave":"donatario_conjuge_nome"}},{"type":"text","text":", (nacionalidade), (profissão), (filiação), e-mail "},{"type":"campo","attrs":{"chave":"donatario_conjuge_email"}},{"type":"text","text":" , portador (a) da Carteira de Identidade nº "},{"type":"campo","attrs":{"chave":"donatario_conjuge_rg"}},{"type":"text","text":" expedida pelo "},{"type":"campo","attrs":{"chave":"donatario_conjuge_rg_orgao"}},{"type":"text","text":" em "},{"type":"campo","attrs":{"chave":"donatario_conjuge_rg_data"}},{"type":"text","text":" , inscrito (a) no CPF sob o nº "},{"type":"campo","attrs":{"chave":"donatario_conjuge_cpf"}},{"type":"text","text":" , residente e domiciliado (a) no (endereço completo). O (s) presente (s) foram identificados face à apresentação dos documentos supracitados, ora a mim exibidos, do que dou fé. Então, pelas partes, me foi dito o seguinte: "},{"type":"text","text":"CLÁUSULA","marks":[{"type":"bold"},{"type":"underline"}]},{"type":"text","text":" ","marks":[{"type":"underline"}]},{"type":"text","text":"PRIMEIRA – DO IMÓVEL","marks":[{"type":"bold"},{"type":"underline"}]},{"type":"text","text":": 1.1. ","marks":[{"type":"bold"}]},{"type":"text","text":"O(s) "},{"type":"text","text":"DOADOR (ES) ","marks":[{"type":"bold"}]},{"type":"text","text":"é/são"},{"type":"text","text":" ","marks":[{"type":"bold"}]},{"type":"text","text":"dono (s), senhor (es), legítimo (s) possuidor (es) e proprietário (s) do imóvel designado por (tipologia) nº "},{"type":"campo","attrs":{"chave":"imovel_numero"}},{"type":"text","text":" complemento "},{"type":"campo","attrs":{"chave":"imovel_complemento"}},{"type":"text","text":" , situado (endereço completo), com fração de (medida) do terreno e benfeitorias,  (listar separadamente), (localização), (especificações),  devidamente descrito, confrontado e caracterizado na matrícula n° "},{"type":"campo","attrs":{"chave":"imovel_matricula"}},{"type":"text","text":" do "},{"type":"campo","attrs":{"chave":"imovel_cartorio"}},{"type":"text","text":" Ofício do Registro de Imóveis da Cidade "},{"type":"campo","attrs":{"chave":"imovel_cartorio_cidade"}},{"type":"text","text":" e inscrito perante a Prefeitura Municipal do Estado do "},{"type":"campo","attrs":{"chave":"imovel_prefeitura_uf"}},{"type":"text","text":" sob o nº "},{"type":"campo","attrs":{"chave":"imovel_inscricao_municipal"}},{"type":"text","text":" e C.L. "},{"type":"campo","attrs":{"chave":"imovel_cl"}},{"type":"text","text":" "},{"type":"text","text":"(“","marks":[{"type":"bold"}]},{"type":"text","text":"Imóvel","marks":[{"type":"bold"},{"type":"underline"}]},{"type":"text","text":"”)","marks":[{"type":"bold"}]},{"type":"text","text":". "},{"type":"text","text":"1.2. ","marks":[{"type":"bold"}]},{"type":"text","text":"O"},{"type":"text","text":" Imóvel ","marks":[{"type":"bold"}]},{"type":"text","text":"foi adquirido pelos "},{"type":"text","text":"DOADOR (ES) ","marks":[{"type":"bold"}]},{"type":"text","text":"nos termos da escritura de compra e venda lavrada em __/__/"},{"type":"campo","attrs":{"chave":"aquisicao_ano"}},{"type":"text","text":" perante o "},{"type":"campo","attrs":{"chave":"aquisicao_oficio"}},{"type":"text","text":" Ofício de Notas da Comarca da "},{"type":"campo","attrs":{"chave":"aquisicao_comarca"}},{"type":"text","text":", Livro nº "},{"type":"campo","attrs":{"chave":"aquisicao_livro"}},{"type":"text","text":", fls. "},{"type":"campo","attrs":{"chave":"aquisicao_folhas"}},{"type":"text","text":", ainda pendente de registro na matrícula do "},{"type":"text","text":"Imóvel","marks":[{"type":"bold"}]},{"type":"text","text":". "},{"type":"text","text":"CLÁUSULA SEGUNDA – DA SITUAÇÃO JURÍDICA E FISCAL DO IMÓVEL","marks":[{"type":"bold"},{"type":"underline"}]},{"type":"text","text":":","marks":[{"type":"bold"}]},{"type":"text","text":" "},{"type":"text","text":"2.1.","marks":[{"type":"bold"}]},{"type":"text","text":" O (s) "},{"type":"text","text":"DOADOR (ES)","marks":[{"type":"bold"}]},{"type":"text","text":" declaram e garantem ao/à "},{"type":"text","text":"DONATÁRIO (A) ","marks":[{"type":"bold"}]},{"type":"text","text":"que o "},{"type":"text","text":"IMÓVEL","marks":[{"type":"bold"}]},{"type":"text","text":" se encontra livre e desembaraçado de quaisquer ônus, judiciais ou extrajudiciais, real ou pessoal, de hipotecas legais ou convencionais, dívidas, dúvidas, penhoras, arresto, sequestro, foro ou pensão, e bem assim quite de impostos, taxas e demais contribuições fiscais ou encargos de qualquer natureza, inclusive condominiais, estando livre, ainda, de qualquer limitação e/ou contingência. "},{"type":"text","text":"CLÁUSULA TERCEIRA – DA DOAÇÃO","marks":[{"type":"bold"},{"type":"underline"}]},{"type":"text","text":": 3.1. ","marks":[{"type":"bold"}]},{"type":"text","text":"O (s) "},{"type":"text","text":"DOADOR (ES)","marks":[{"type":"bold"}]},{"type":"text","text":", possuindo outros bens e meios suficientes para sua subsistência, sem que haja violação dos artigos 548 e 549 do Código Civil, por esta escritura e nos melhores termos de direito, de sua livre e espontânea vontade, sem constrangimento, coação, pressão, dolo, malícia ou influência de outrem, doam, como efetivamente doado fica, ao/à "},{"type":"text","text":"OUTORGADO (A)","marks":[{"type":"bold"}]},{"type":"text","text":" o "},{"type":"text","text":"Imóvel","marks":[{"type":"bold"}]},{"type":"text","text":" descrito e caracterizado na Cláusula 1.1. acima, cedendo e transmitindo-lhe, em consequência, toda posse, domínio, direito e ação sobre o aludido "},{"type":"text","text":"Imóvel ","marks":[{"type":"bold"}]},{"type":"text","text":"ora doado, desde já, cedido e transmitido, obrigando-se o (s) "},{"type":"text","text":"OUTORGANTE (S)","marks":[{"type":"bold"}]},{"type":"text","text":" por si, seu (s) herdeiro (s) ou sucessor (es) a fazerem a presente doação sempre boa, firme e valiosa e a responder pela evicção de direito. "},{"type":"text","text":"3.2. ","marks":[{"type":"bold"}]},{"type":"text","text":"Em razão"},{"type":"text","text":" ","marks":[{"type":"bold"}]},{"type":"text","text":"da imissão do (a) "},{"type":"text","text":"DONATÁRIO (A) ","marks":[{"type":"bold"}]},{"type":"text","text":"na posse neste ato, passa a correr por conta sua responsabilidade todos os tributos, tarifas e quaisquer encargos que, a partir dessa data, incidam sobre o "},{"type":"text","text":"Imóvel","marks":[{"type":"bold"}]},{"type":"text","text":", permanecendo sob a inteira responsabilidade do (s) "},{"type":"text","text":"DOADOR (ES) ","marks":[{"type":"bold"}]},{"type":"text","text":"aqueles decorrentes de fatos geradores anteriores, ainda que posteriormente lançados ou cobrados; "},{"type":"text","text":"3.3.","marks":[{"type":"bold"}]},{"type":"text","text":" Para efeitos fiscais, atribui-se à presente doação o valor de "},{"type":"text","text":"R$ ","marks":[{"type":"bold"}]},{"type":"campo","attrs":{"chave":"valor"},"marks":[{"type":"bold"}]},{"type":"text","text":" (valor) (valor de aquisição do imóvel + benfeitorias no valor de R$ ","marks":[{"type":"bold"}]},{"type":"campo","attrs":{"chave":"valor_benfeitorias"},"marks":[{"type":"bold"}]},{"type":"text","text":")","marks":[{"type":"bold"}]},{"type":"text","text":" para o "},{"type":"text","text":"Imóvel","marks":[{"type":"bold"}]},{"type":"text","text":" e as benfeitorias nele existentes"},{"type":"text","text":". ","marks":[{"type":"bold"}]},{"type":"text","text":"CLÁUSULA QUARTA - DA IMPENHORABILIDADE E INCOMUNICABILIDADE","marks":[{"type":"bold"},{"type":"underline"}]},{"type":"text","text":": 4.1. ","marks":[{"type":"bold"}]},{"type":"text","text":"Os "},{"type":"text","text":"DOADOR (ES)","marks":[{"type":"bold"}]},{"type":"text","text":" fazem a presente doação com as cláusulas expressas de "},{"type":"text","text":"impenhorabilidade","marks":[{"type":"underline"}]},{"type":"text","text":" e "},{"type":"text","text":"incomunicabilidade","marks":[{"type":"underline"}]},{"type":"text","text":", extensiva aos frutos e rendimentos oriundos do "},{"type":"text","text":"Imóvel","marks":[{"type":"bold"}]},{"type":"text","text":" objeto da presente doação assim como aos bens que se sub-rogarem no "},{"type":"text","text":"Imóvel","marks":[{"type":"bold"}]},{"type":"text","text":" (e nos seus respectivos frutos), renunciando o (s) "},{"type":"text","text":"DOADOR (ES)","marks":[{"type":"bold"}]},{"type":"text","text":", expressamente, à faculdade de arrependimento concedida pela legislação civil. "},{"type":"text","text":"4.2","marks":[{"type":"bold"}]},{"type":"text","text":". A imposição das cláusulas acima se torna indispensável, por se tratar de bem adquirido com exaustivo esforço e labuta, fruto de anos de trabalho e luta para consolidar o patrimônio dele (s), "},{"type":"text","text":"DOADOR (ES)","marks":[{"type":"bold"}]},{"type":"text","text":", os quais com a imposição das cláusulas, visam o bem estar do (a) "},{"type":"text","text":"DONATÁRIO (A)","marks":[{"type":"bold"}]},{"type":"text","text":" e que a mesma possa preservar e manter o patrimônio amealhado, de maneira a lhe proporcionar renda para um futuro tranquilo, estando certos de que desta maneira, estão beneficiando-o (a). "},{"type":"text","text":"CLÁUSULA \tQUINTA - DISPOSIÇÕES FINAIS","marks":[{"type":"bold"},{"type":"underline"}]},{"type":"text","text":": 5.1.","marks":[{"type":"bold"}]},{"type":"text","text":" Os "},{"type":"text","text":"DOADOR (ES)","marks":[{"type":"bold"}]},{"type":"text","text":" declaram expressamente, na forma e sob as penas da lei, que está desobrigado da apresentação de comprovante de inexistência de débitos com o Instituto Nacional do Seguro Social (INSS) e da Receita Federal do Brasil, visto que não é contribuinte obrigatório; "},{"type":"text","text":"5.2.","marks":[{"type":"bold"}]},{"type":"text","text":" Observados os termos e condições aqui previstos, a presente escritura é celebrada sob condição expressa de sua irretratabilidade e irrevogabilidade, ressalvadas as hipóteses legais de revogação da doação, renunciando as Partes, expressamente, à faculdade de arrependimento concedida pela legislação civil. "},{"type":"text","text":"5.3. ","marks":[{"type":"bold"}]},{"type":"text","text":"O (A) "},{"type":"text","text":"DONATÁRIO (A)","marks":[{"type":"bold"}]},{"type":"text","text":" declara para os devidos fins que aceita a presente escritura em todos os seus expressos termos e encargo. "}]},{"type":"paragraph","attrs":{"textAlign":"justify"}},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"DO ENCERRAMENTO: Foi emitida D.O.I., conforme I.N. da SRF 1112, de 28.12.2010, publicada no D.O.U. de 30.12.2010. Eu, "},{"type":"campo","attrs":{"chave":"escrevente_nome"},"marks":[{"type":"bold"}]},{"type":"text","text":",","marks":[{"type":"bold"}]},{"type":"text","text":" Escrevente, conforme Lei Federal nº 8.935 de 18.11.1994 e publicada no Diário Oficial em 21.11.1994, lavrei, li, a presente, colhendo as assinaturas. Eu, "},{"type":"campo","attrs":{"chave":"substituto_tabeliao_nome"},"marks":[{"type":"bold"}]},{"type":"text","text":", SUBSTITUTO (A) DO TABELIÃO, subscrevo, assino e encerro a presente lavratura. "}]},{"type":"paragraph","attrs":{"textAlign":"justify"}},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"_________________________________________"}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"OUTORGANTE (S) DOADOR (A) (ES)","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"textAlign":"justify"}},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"_________________________________________"}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"OUTORGADO (A) DONATÁRIO (A)","marks":[{"type":"bold"}]}]}]}}