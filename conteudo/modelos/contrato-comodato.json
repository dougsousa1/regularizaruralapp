}]},{"type":"text","text":". As benfeitorias necessárias realizadas pelo "},{"type":"text","text":"Comodatário","marks":[{"type":"bold"}]},{"type":"text","text":" serão indenizáveis pelo "},{"type":"text","text":"Comodante","marks":[{"type":"bold"}]},{"type":"text","text":" ao final do Contrato. "}]},{"type":"paragraph","attrs":{"textAlign":"justify","recuo":2}},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"CLÁUSULA SEXTA - DAS DESPESAS","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"textAlign":"justify"}},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"6.1.\t","marks":[{"type":"bold"}]},{"type":"text","text":"Todas as despesas decorrentes do uso do imóvel rural, tais como água, luz, impostos e taxas, correrão por conta exclusiva do "},{"type":"text","text":"Comodatário","marks":[{"type":"bold"}]},{"type":"text","text":"."}]},{"type":"paragraph","attrs":{"textAlign":"justify"}},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"CLÁUSULA SÉTIMA - DA RESCISÃO","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"textAlign":"justify"}},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"7.1.","marks":[{"type":"bold"}]},{"type":"text","text":"\tO presente Contrato poderá ser rescindido antes do término do prazo estipulado nas seguintes hipóteses:"}]},{"type":"paragraph","attrs":{"textAlign":"left"},"content":[{"type":"text","text":"(i) por acordo mútuo entre as Partes;"}]},{"type":"paragraph","attrs":{"textAlign":"left"},"content":[{"type":"text","text":"(ii) pelo descumprimento de qualquer das cláusulas contratuais; e"}]},{"type":"paragraph","attrs":{"textAlign":"left"},"content":[{"type":"text","text":"(iii) por necessidade justificada do Comodante."}]},{"type":"paragraph","attrs":{"textAlign":"justify"}},{"type":"paragraph","attrs":{"textAlign":"left"},"content":[{"type":"text","text":"CLÁUSULA OITAVA – D