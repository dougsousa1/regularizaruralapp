ntent":[{"type":"text","text":"DECLARAÇÃO DE POSSE DO IMÓVEL RURAL","marks":[{"type":"bold"},{"type":"underline"}]}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"A Secretaria de Agricultura do Município de "},{"type":"campo","attrs":{"chave":"municipio"}},{"type":"text","text":" declara que o Sr. "},{"type":"campo","attrs":{"chave":"cliente_nome"}},{"type":"text","text":", ","marks":[{"type":"bold"}]},{"type":"text","text":"nacionalidade, estado civil, profissão, portador da cédula de identidade RG n° "},{"type":"campo","attrs":{"chave":"cliente_rg"}},{"type":"text","text":", "},{"type":"campo","attrs":{"chave":"cliente_rg_orgao"}},{"type":"text","text":", inscrito sob CPF/MF sob n° "},{"type":"campo","attrs":{"chave":"cliente_cpf"}},{"type":"text","text":", residente e domiciliado na "},{"type":"campo","attrs":{"chave":"cliente_endereco"}},{"type":"text","text":", adquiriu do  Sr. "},{"type":"campo","attrs":{"chave":"cedente_nome"}},{"type":"text","text":", ","marks":[{"type":"bold"}]},{"type":"text","text":"nacionalidade, estado civil, profissão, portador da cédula de identidade RG n° "},{"type":"campo","attrs":{"chave":"cedente_rg"}},{"type":"text","text":", "},{"type":"campo","attrs":{"chave":"cedente_rg_orgao"}},{"type":"text","text":", inscrito sob CPF/MF sob n° "},{"type":"campo","attrs":{"chave":"cedente_cpf"}},{"type":"text","text":" e sua cônjuge "},{"type":"campo","attrs":{"chave":"cedente_conjuge_nome"}},{"type":"text","text":", nacionalidade, estado civil, profissão, portador da cédula de identidade RG n° "},{"type":"campo","attrs":{"chave":"cedente_conjuge_rg"}},{"type":"text","text":", "},{"type":"campo","attrs":{"chave":"cedente_conjuge_rg_orgao"}},{"type":"text","text":", inscrita sob CPF/MF sob n° "},{"type":"campo","attrs":{"chave":"cedente_conjuge_cpf"}},{"type":"text","text":", ambos residentes e domiciliados na "},{"type":"campo","attrs":{"chave":"cedente_endereco"}},{"type":"text","text":", por meio do "},{"type":"campo","attrs":{"chave":"instrumento_aquisicao"}},{"type":"text","text":" celebrado em ../../...., os direitos possessórios do imóvel rural denominado "},{"type":"campo","attrs":{"chave":"imovel_denominacao"}},{"type":"text","text":", com área total de "},{"type":"campo","attrs":{"chave":"imovel_area_ha"}},{"type":"text","text":" hectares, localizado na "},{"type":"campo","attrs":{"chave":"imovel_endereco"}},{"type":"text","text":" Município de "},{"type":"campo","attrs":{"chave":"imovel_municipio"}},{"type":"text","text":". Estado de "},{"type":"campo","attrs":{"chave":"imovel_uf"}},{"type":"text","text":"; "}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"O único confrontante do imóvel o Sr. "},{"type":"campo","attrs":{"chave":"confrontante_nome"}},{"type":"text","text":", nacionalidade, estado civil, profissão, portador da cédula de identidade RG n° "},{"type":"campo","attrs":{"chave":"confrontante_rg"}},{"type":"text","text":", "},{"type":"campo","attrs":{"chave":"confrontante_rg_orgao"}},{"type":"text","text":", inscrito sob CPF/MF sob n° "},{"type":"campo","attrs":{"chave":"confrontante_cpf"}},{"type":"text","text":", residente e domiciliado na "},{"type":"campo","attrs":{"chave":"confrontante_endereco"}},{"type":"text","text":", que detem a posse do imóvel contiguo ao imóvel rural há "},{"type":"campo","attrs":{"chave":"confrontante_posse_anos"}},{"type":"text","text":" anos, declara que tem conhecimento que o Sr. "},{"type":"campo","attrs":{"chave":"cliente_nome"}},{"type":"text","text":" adquiriu o imóvel em "},{"type":"campo","attrs":{"chave":"aquisicao_mes_ano"}},{"type":"text","text":" de "},{"type":"campo","attrs":{"chave":"cedente_e_conjuge_nomes"}},{"type":"text","text":" e, desde então, o Sr. "},{"type":"campo","attrs":{"chave":"cliente_nome"}},{"type":"text","text":", vem exercendo a posse mansa e pacífica do imóvel rural, não tendo conhecimento de domínio ou propriedade de terceiros."}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"Por fim, as partes acima, declaram ainda, que não existe, sobre o imóvel rural em referência, domínio ou propriedade de terceiros, não se tratando, inclusive, de um bem constitutivo do espólio de uma pessoa falecida ainda não inventariado. "}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"Coordenadas Geográficas: \tLat: "},{"type":"campo","attrs":{"chave":"imovel_latitude"}}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"\t\t\t\tLon: "},{"type":"campo","attrs":{"chave":"imovel_longitude"}}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"Para efeito de comprovação, esta declaração vai assinada pelo técnico da Casa da Agricultura de "},{"type":"campo","attrs":{"chave":"casa_agricultura"}},{"type":"text","text":", após a vistoria da propriedade, e a documentação dos confrontantes e testemunhas em anexo. "}]},{"type":"paragraph","attrs":{"textAlign":"justify"}},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"campo","attrs":{"chave":"local_data"}}]},{"type":"paragraph","attrs":{"textAlign":"center"}},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"text","text":"______________________________________"}]},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"text","text":"CASA DA AGRICULTURA DE "},{"type":"campo","attrs":{"chave":"casa_agricultura"}}]},{"type":"paragraph","attrs":{"textAlign":"center"}},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"text","text":"______________________________________"}]},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"campo","attrs":{"chave":"cliente_nome"}}]},{"type":"paragraph","attrs":{"textAlign":"center"}},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"text","text":"______________________________________"}]},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"campo","attrs":{"chave":"confrontante_nome"}}]}]}}