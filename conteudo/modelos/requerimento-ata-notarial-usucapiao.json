_nome"},"marks":[{"type":"bold"}]},{"type":"text","text":" CARTÓRIO DE NOTAS DA COMARCA DE ","marks":[{"type":"bold"}]},{"type":"campo","attrs":{"chave":"comarca"},"marks":[{"type":"bold"}]},{"type":"text","text":", ESTADO DE ","marks":[{"type":"bold"}]},{"type":"campo","attrs":{"chave":"uf"},"marks":[{"type":"bold"}]},{"type":"text","text":",","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"textAlign":"left"}},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"campo","attrs":{"chave":"requerente_nome"}},{"type":"text","text":","},{"type":"text","text":" ","marks":[{"type":"bold"}]},{"type":"text","text":"nacionalidade, estado civil, profissão, portador da cédula de identidade RG n° "},{"type":"campo","attrs":{"chave":"requerente_rg"}},{"type":"text","text":", "},{"type":"campo","attrs":{"chave":"requerente_rg_orgao"}},{"type":"text","text":", inscrito no CPF/MF n° "},{"type":"campo","attrs":{"chave":"requerente_cpf"}},{"type":"text","text":", (endereço eletrônico – e-mail: "},{"type":"campo","attrs":{"chave":"requerente_email"}},{"type":"text","text":"), casado com "},{"type":"campo","attrs":{"chave":"requerente_conjuge_nome"}},{"type":"text","text":", nacionalidade, estado civil, profissão, portadora da cédula de identidade RG n° "},{"type":"campo","attrs":{"chave":"requerente_conjuge_rg"}},{"type":"text","text":", "},{"type":"campo","attrs":{"chave":"requerente_conjuge_rg_orgao"}},{"type":"text","text":", inscrita no CPF/MF n° "},{"type":"campo","attrs":{"chave":"requerente_conjuge_cpf"}},{"type":"text","text":", (endereço eletrônico – e-mail: "},{"type":"campo","attrs":{"chave":"requerente_conjuge_email"}},{"type":"text","text":"), sob o regime de bens "},{"type":"campo","attrs":{"chave":"requerente_regime_bens"}},{"type":"text","text":", ambos residentes e domiciliados na "},{"type":"campo","attrs":{"chave":"requerente_endereco"}},{"type":"text","text":", respectivamente, neste ato representados por seu advogado, conforme procuração constante do ANEXO 1 ao presente instrumento, vêm, respeitosamente à presença de Vossa Senhoria, "},{"type":"text","text":"REQUERER A LAVRATURA DA ATA NOTARIAL PARA FINS DE EXTERIORIZAÇÃO DA POSSE, DOS INDÍCIOS DE SUA DURAÇÃO E DE OUTRAS CIRCUNSTÂNCIAS RELEVANTES PARA O RECONHECIMENTO DA USUCAPIÃO EXTRAJUDICIAL","marks":[{"type":"bold"},{"type":"underline"}]},{"type":"text","text":" ","marks":[{"type":"bold"}]},{"type":"text","text":"do imóvel rural abaixo descrito, com fulcro nos artigos 216-A da Lei 6.015/73 e no artigo 398 e seguintes do Provimento n. 149 do Conselho Nacional de Justiça, de 30 de agosto de 2023, que instituiu o Código de Normas Nacional de Justiça, conforme exposição fática adiante:"}]},{"type":"paragraph","attrs":{"textAlign":"justify","recuo":1},"content":[{"type":"text","text":"1.   ","marks":[{"type":"bold"}]},{"type":"text","text":"DESCRIÇÃO DO IMÓVEL","marks":[{"type":"bold"},{"type":"underline"}]}]},{"type":"paragraph","attrs":{"textAlign":"justify","recuo":1}},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"1.1. Os Requerentes são legítimos possuidores e mantêm a posse mansa, pacífica e ininterrupta, por mais de "},{"type":"campo","attrs":{"chave":"posse_anos"}},{"type":"text","text":" anos, de um imóvel rural designado por "},{"type":"campo","attrs":{"chave":"imovel_denominacao"}},{"type":"text","text":", situado no "},{"type":"campo","attrs":{"chave":"imovel_endereco"}},{"type":"text","text":", com área total de "},{"type":"campo","attrs":{"chave":"imovel_area_ha"}},{"type":"text","text":" hectares, objeto da matrícula n.º "},{"type":"campo","attrs":{"chave":"imovel_matricula"}},{"type":"text","text":" do "},{"type":"campo","attrs":{"chave":"imovel_cartorio"}},{"type":"text","text":"º Ofício de Registro de Imóveis da Comarca de "},{"type":"campo","attrs":{"chave":"imovel_comarca"}},{"type":"text","text":", Estado "},{"type":"campo","attrs":{"chave":"imovel_uf"}},{"type":"text","text":", o qual assim se descreve, conforme certidão : "},{"type":"campo","attrs":{"chave":"imovel_descricao"},"marks":[{"type":"italic"}]},{"type":"text","text":" (ANEXO 2)"}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"1.2. O imóvel está devidamente cadastrado junto ao Sistema Nacional de Cadastro Rural sob o código nº "},{"type":"campo","attrs":{"chave":"imovel_ccir"}},{"type":"text","text":" e possui Certificado do Cadastro do Imóvel Rural (CCIR) sob nº "},{"type":"campo","attrs":{"chave":"imovel_ccir_numero"}},{"type":"text","text":" (ANEXO 3)."}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"1.3. O imóvel também se encontra devidamente inscrito junto à Receita Federal, conforme comprovado pelo número de inscrição NIRF/CIB "},{"type":"campo","attrs":{"chave":"imovel_nirf"}},{"type":"text","text":" (ANEXO 4). "}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"1.4. O imóvel possui Cadastro Ambiental Rural conforme Recibo de Inscrição nº "},{"type":"campo","attrs":{"chave":"imovel_car"}},{"type":"text","text":" (ANEXO 5)."}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"1.5.","marks":[{"type":"bold"}]},{"type":"text","text":" \tNão há qualquer tipo de edificação, benfeitoria ou qualquer acessão no imóvel. "},{"type":"campo","attrs":{"chave":"imovel_benfeitorias"},"marks":[{"type":"italic"}]}]},{"type":"paragraph","attrs":{"textAlign":"justify","recuo":1},"content":[{"type":"text","text":"2.   ","marks":[{"type":"bold"}]},{"type":"text","text":"TEMPO E CARACTERÍSTICAS DA POSSE ","marks":[{"type":"bold"},{"type":"underline"}]}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"2.1.","marks":[{"type":"bold"}]},{"type":"text","text":"\tOs Requerentes declaram sob as penas da Lei, para fins de instrução da Ata Notarial, que exercem a posse mansa, pacífica, ininterrupta, sem qualquer oposição de terceiros do imóvel há mais de "},{"type":"campo","attrs":{"chave":"posse_anos"}},{"type":"text","text":" anos, ou seja, desde "},{"type":"campo","attrs":{"chave":"posse_inicio"}},{"type":"text","text":" em razão da sucessão possessória."}]},{"type":"paragraph","attrs":{"textAlign":"justify","recuo":1},"content":[{"type":"text","text":"3. ","marks":[{"type":"bold"}]},{"type":"text","text":"FORMA DE AQUISIÇÃO DA POSSE","marks":[{"type":"bold"},{"type":"underline"}]}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"3.1.\t","marks":[{"type":"bold"}]},{"type":"text","text":"\tOs Requerentes celebraram, em "},{"type":"campo","attrs":{"chave":"compra_data"}},{"type":"text","text":", Instrumento Particular de Compra e Venda do imóvel com "},{"type":"campo","attrs":{"chave":"vendedor_nome"}},{"type":"text","text":","},{"type":"text","text":" ","marks":[{"type":"bold"}]},{"type":"text","text":"nacionalidade, estado civil, profissão, portador da cédula de identidade RG n° "},{"type":"campo","attrs":{"chave":"vendedor_rg"}},{"type":"text","text":", "},{"type":"campo","attrs":{"chave":"vendedor_rg_orgao"}},{"type":"text","text":", inscrito no CPF/MF n° "},{"type":"campo","attrs":{"chave":"vendedor_cpf"}},{"type":"text","text":" e sua cônjuge "},{"type":"campo","attrs":{"chave":"vendedor_conjuge_nome"}},{"type":"text","text":", nacionalidade, estado civil, profissão, portadora da cédula de identidade RG n° "},{"type":"campo","attrs":{"chave":"vendedor_conjuge_rg"}},{"type":"text","text":", "},{"type":"campo","attrs":{"chave":"vendedor_conjuge_rg_orgao"}},{"type":"text","text":", inscrita no CPF/MF n° "},{"type":"campo","attrs":{"chave":"vendedor_conjuge_cpf"}},{"type":"text","text":", casados, sob o regime de bens "},{"type":"campo","attrs":{"chave":"vendedor_regime_bens"}},{"type":"text","text":", ambos residentes e domiciliados na "},{"type":"campo","attrs":{"chave":"vendedor_endereco"}},{"type":"text","text":" (ANEXO 6) e, desde então, gozam da posse do imóvel, conforme pode ser verificado das provas juntadas, de forma mansa, pacífica e exclusiva, sem qualquer oposição, constrangimento, impugnação, contestação ou turbação."}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"3.2.","marks":[{"type":"bold"}]},{"type":"text","text":"\tPor sua vez, "},{"type":"campo","attrs":{"chave":"vendedor_nome"}},{"type":"text","text":" adquiriu o imóvel por meio de "},{"type":"campo","attrs":{"chave":"vendedor_titulo_aquisicao"}},{"type":"text","text":" (ANEXO 7).  "}]},{"type":"paragraph","attrs":{"textAlign":"left"},"content":[{"type":"text","text":"4.","marks":[{"type":"bold"}]},{"type":"text","text":"\t"},{"type":"text","text":"SOMA DA POSSE","marks":[{"type":"bold"},{"type":"underline"}]}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"4.1.","marks":[{"type":"bold"}]},{"type":"text","text":"\tConforme descrito no “Item 2” acima, a posse dos Requerentes atinge mais de "},{"type":"campo","attrs":{"chave":"posse_anos"}},{"type":"text","text":" anos, ultrapassando, portanto, o requisito da modalidade da usucapião mais extensa prevista em lei, qual seja, a usucapião extraordinária, em razão do acréscimo da posse, nos termos do artigo 1243 do"},{"type":"text","text":" ","marks":[{"type":"bold"}]},{"type":"text","text":"Código Civil: "},{"type":"campo","attrs":{"chave":"nota_soma_posse"}},{"type":"text","text":" ","marks":[{"type":"italic"}]}]},{"type":"paragraph","attrs":{"textAlign":"justify","recuo":3},"content":[{"type":"text","text":"Art. 1.243: “O possuidor pode, para o fim de contar o tempo exigido pelos artigos antecedentes, acrescentar à sua posse a dos seus antecessores (art. 1.207), contanto que todas sejam contínuas, pacíficas e, nos casos do art. 1.242, com justo título e de boa-fé”.","marks":[{"type":"italic"}]}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"5.  \t","marks":[{"type":"bold"}]},{"type":"text","text":"MODALIDADE DE USUCAPIÃO PRETENDIDA","marks":[{"type":"bold"},{"type":"underline"}]}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"5.1.","marks":[{"type":"bold"}]},{"type":"text","text":"\tDessa forma, uma vez devidamente comprovada a posse dos Requerentes, de forma mansa, pacífica e ininterrupta, por mais de 15 anos, fazem jus ao reconhecimento extrajudicial de "},{"type":"text","text":"USUCAPIÃO EXTRAORDINÁRIA","marks":[{"type":"bold"},{"type":"underline"}]},{"type":"text","text":", conforme dispõe o Código Civil no art. 1.238: "},{"type":"campo","attrs":{"chave":"nota_modalidade"}},{"type":"text","text":" ","marks":[{"type":"italic"}]}]},{"type":"paragraph","attrs":{"textAlign":"justify"}},{"type":"paragraph","attrs":{"textAlign":"justify","recuo":3},"content":[{"type":"text","text":" "},{"type":"text","text":"Art. 1.238: “Aquele que, por quinze anos, sem interrupção, nem oposição, possuir como seu um imóvel, adquire-lhe a propriedade, independentemente de título e boa-fé; podendo requerer ao juiz que assim o declare por sentença, a qual servirá de título para o registro no Cartório de Registro de Imóveis”. ","marks":[{"type":"italic"}]}]},{"type":"paragraph","attrs":{"textAlign":"justify","recuo":3}},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"6.\t","marks":[{"type":"bold"}]},{"type":"text","text":"NÚMERO DE IMÓVEIS ATINGIDOS","marks":[{"type":"bold"},{"type":"underline"}]},{"type":"text","text":": ","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"6.1.","marks":[{"type":"bold"}]},{"type":"text","text":"\tOs Requerentes declaram que há apenas um imóvel atingido, que para todos os efeitos tem suas medidas descritas na matrícula nº "},{"type":"campo","attrs":{"chave":"imovel_matricula"}},{"type":"text","text":" do Cartório de Registro de Imóveis de "},{"type":"campo","attrs":{"chave":"imovel_comarca"}},{"type":"text","text":"."}]},{"type":"paragraph","attrs":{"textAlign":"left"},"content":[{"type":"text","text":"7.\t","marks":[{"type":"bold"}]},{"type":"text","text":"VALOR DO IMÓVEL","marks":[{"type":"bold"},{"type":"underline"}]}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"7.1.\t","marks":[{"type":"bold"}]},{"type":"text","text":"Declaram os Requerentes, nos termos do artigo 401, inciso I, alínea “f” do provimento 149/2023 do CNJ, que o valor do imóvel é de R$ "},{"type":"campo","attrs":{"chave":"valor"}},{"type":"text","text":", conforme se depreende do valor constante da Declaração do Imposto sobre a Propriedade Territorial Rural – ITR."}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"8.","marks":[{"type":"bold"}]},{"type":"text","text":" \t"},{"type":"text","text":"OUTRAS INFORMAÇÕES PERTINENTES","marks":[{"type":"bold"},{"type":"underline"}]}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"8.1.","marks":[{"type":"bold"}]},{"type":"text","text":"\tOs Requerentes apresentam para fins de instrução deste procedimento, as seguintes testemunhas para prestar depoimentos:"}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"a) "},{"type":"campo","attrs":{"chave":"testemunha1_nome"}},{"type":"text","text":","},{"type":"text","text":" ","marks":[{"type":"bold"}]},{"type":"text","text":"nacionalidade, estado civil, profissão, portador da cédula de identidade RG n° "},{"type":"campo","attrs":{"chave":"testemunha1_rg"}},{"type":"text","text":", "},{"type":"campo","attrs":{"chave":"testemunha1_rg_orgao"}},{"type":"text","text":", inscrito sob CPF/MF sob n° "},{"type":"campo","attrs":{"chave":"testemunha1_cpf"}},{"type":"text","text":", residente e domiciliado na "},{"type":"campo","attrs":{"chave":"testemunha1_endereco"}},{"type":"text","text":", com endereço eletrônico – e-mail: "},{"type":"campo","attrs":{"chave":"testemunha1_email"}},{"type":"text","text":"; e "}]},{"type":"paragraph","attrs":{"textAlign":"justify"}},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"b)  "},{"type":"campo","attrs":{"chave":"testemunha2_nome"}},{"type":"text","text":","},{"type":"text","text":" ","marks":[{"type":"bold"}]},{"type":"text","text":"nacionalidade, estado civil, profissão, portador da cédula de identidade RG n° "},{"type":"campo","attrs":{"chave":"testemunha2_rg"}},{"type":"text","text":", "},{"type":"campo","attrs":{"chave":"testemunha2_rg_orgao"}},{"type":"text","text":", inscrito sob CPF/MF sob n° "},{"type":"campo","attrs":{"chave":"testemunha2_cpf"}},{"type":"text","text":", residente e domiciliado na "},{"type":"campo","attrs":{"chave":"testemunha2_endereco"}},{"type":"text","text":", com endereço eletrônico – e-mail: "},{"type":"campo","attrs":{"chave":"testemunha2_email"}},{"type":"text","text":". "}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"9.\t","marks":[{"type":"bold"}]},{"type":"text","text":"DOCUMENTOS APRESENTADOS","marks":[{"type":"bold"},{"type":"underline"}]}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"9.1.","marks":[{"type":"bold"}]},{"type":"text","text":"\tA fim de corroborar suas alegações e comprovar o tempo de posse do imóvel, os Requerentes apresentam ainda os seguintes documentos:   "}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"a) Planta e Memorial Descritivo do imóvel elaborados por profissional devidamente habilitado no "},{"type":"campo","attrs":{"chave":"responsavel_tecnico_conselho"}},{"type":"text","text":" e "},{"type":"campo","attrs":{"chave":"responsavel_tecnico_art_tipo"}},{"type":"text","text":" nº "},{"type":"campo","attrs":{"chave":"responsavel_tecnico_art"}},{"type":"text","text":" devidamente quitada (ANEXO 8)"}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"b) Comprovantes de contas de consumo de luz anos "},{"type":"campo","attrs":{"chave":"contas_luz_ano_inicio"}},{"type":"text","text":" a "},{"type":"campo","attrs":{"chave":"contas_luz_ano_fim"}},{"type":"text","text":" (ANEXO 9);"}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"c) Certidões negativas de débitos relativos ao ITR emitidas em "},{"type":"campo","attrs":{"chave":"itr_certidoes_data"}},{"type":"text","text":" (ANEXO 10);"}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"d) Declaração anual de imposto de renda apresentada à Secretaria da Receita Federal do Brasil, dos exercícios de "},{"type":"campo","attrs":{"chave":"ir_exercicio_inicio"}},{"type":"text","text":" a "},{"type":"campo","attrs":{"chave":"ir_exercicio_fim"}},{"type":"text","text":" (ANEXO 11);"}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"e) Declaração Confrontante (ANEXO 12);  "}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"f) "},{"type":"campo","attrs":{"chave":"documentos_outros"}},{"type":"text","text":". ["},{"type":"text","text":"Pegar com o Cartório a lista de certidões que o Registro de Imóveis vai exigir para o processamento da Usucapião Extrajudicial. Se as certidões forem apresentadas ao Cartório de Notas quando da lavratura da Ata Notarial, o procedimento fica mais embasado para a fase do Registro de Imóveis","marks":[{"type":"italic"}]},{"type":"text","text":"].  "}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"10.\t","marks":[{"type":"bold"}]},{"type":"text","text":"DECLARAÇÕES FINAIS:","marks":[{"type":"bold"},{"type":"underline"}]}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"10.1.","marks":[{"type":"bold"}]},{"type":"text","text":"\tOs Requerentes declaram que foram cientificados pelo Tabelião de Notas que a Ata Notarial não tem valor como confirmação ou estabelecimento de propriedade, servindo apenas para a instrução de requerimento extrajudicial de usucapião para processamento perante o Oficial de Registro de Imóveis da Comarca "},{"type":"campo","attrs":{"chave":"imovel_comarca"}},{"type":"text","text":", Estado "},{"type":"campo","attrs":{"chave":"imovel_uf"}},{"type":"text","text":". "}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"10.2.","marks":[{"type":"bold"}]},{"type":"text","text":" \tDeclaram ainda que estão cientes de que a Ata Notarial de Usucapião será considerada ato de conteúdo econômico, devendo o Tabelião tomar por base para cobrança de emolumentos o valor do imóvel previsto no Imposto sobre a Propriedade Territorial Rural - ITR."}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"11.\t","marks":[{"type":"bold"}]},{"type":"text","text":"PEDIDO","marks":[{"type":"bold"},{"type":"underline"}]}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"11.1.","marks":[{"type":"bold"}]},{"type":"text","text":"\tAssim, indubitável que resta comprovada a origem da posse há mais de "},{"type":"campo","attrs":{"chave":"posse_tempo"}},{"type":"text","text":" pelos Requerentes sobre o referido imóvel, bem como a ocupação mansa e pacífica durante todo esse período, pelo que "},{"type":"text","text":"REQUEREM A LAVRATURA DE ATA NOTARIAL","marks":[{"type":"bold"}]},{"type":"text","text":" "},{"type":"text","text":"PARA FINS DE CONSTATAÇÃO DA EXTERIORIZAÇÃO DA POSSE, DOS INDÍCIOS DE SUA DURAÇÃO E DE OUTRAS CIRCUNSTÂNCIAS RELEVANTES PARA FINS DE RECONHECIMENTO EXTRAJUDICIAL DA USUCAPIÃO DO IMÓVEL","marks":[{"type":"bold"}]},{"type":"text","text":", realizando todas as diligências e providências necessárias aos fins requeridos, ciente de que o conteúdo da ata notarial estará vinculado exclusivamente ao que for constatado na documentação apresentada e nas eventuais diligências, bem como que a lavratura da ata notarial não confere direito ao reconhecimento extrajudicial da usucapião extraordinária, sem prejuízo da via judicial, servindo apenas para instruir pedido que será endereçado ao competente registro de imóveis."}]},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"text","text":"Termos em que pede deferimento."}]},{"type":"paragraph","attrs":{"textAlign":"center"}},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"text","text":"Estado, Local e data."}]},{"type":"paragraph","attrs":{"textAlign":"center"}},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"text","text":"_________________________________________"}]},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"campo","attrs":{"chave":"advogado_nome"}}]},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"text","text":"OAB/"},{"type":"campo","attrs":{"chave":"advogado_oab"}}]},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"text","text":"ANEXOS","marks":[{"type":"bold"}]}]},{"type":"paragraph","attrs":{"textAlign":"left"}},{"type":"paragraph","attrs":{"textAlign":"left","recuo":1},"content":[{"type":"text","text":"•   "},{"type":"text","text":"Anexo 1","marks":[{"type":"underline"}]},{"type":"text","text":": Procuração/documentos requerentes e advogado;"}]},{"type":"paragraph","attrs":{"textAlign":"left"},"content":[{"type":"text","text":"• "},{"type":"text","text":"Anexo 2","marks":[{"type":"underline"}]},{"type":"text","text":": Certidão do Imóvel; "}]},{"type":"paragraph","attrs":{"textAlign":"left"},"content":[{"type":"text","text":"• "},{"type":"text","text":"Anexo 3","marks":[{"type":"underline"}]},{"type":"text","text":": Certificado do Cadastro do Imóvel Rural (CCIR);"}]},{"type":"paragraph","attrs":{"textAlign":"left"},"content":[{"type":"text","text":"• "},{"type":"text","text":"Anexo 4","marks":[{"