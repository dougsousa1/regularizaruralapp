":"text","text":"(i) todas as informações e dados apresentadas na planta e no memorial descritivo que acompanham o presente são verdadeiras; "}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"(ii) têm conhecimento do prescrito no art. 213, §14 da Lei n° 6.01/73, que diz: Verificado a qualquer tempo não serem  verdadeiros os fatos constantes do memorial descritivo, responderão os requerentes e o profissional que o elaborou pelos prejuízos causados, independentemente das sanções disciplinares e penais; "}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"(iii) não existe nenhuma disputa ou discordância sobre os limites comuns do imóvel objeto do presente requerimento; e "}]},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"(iv) não existem outros proprietários, titulares de direito ou possuidores dos terrenos confrontantes, a não ser aqueles que assinaram a planta em anexo."}]},{"type":"paragraph","attrs":{"textAlign":"justify"}},{"type":"paragraph","attrs":{"textAlign":"justify"},"content":[{"type":"text","text":"Firmamos a presente por ser expressão da verdade."}]},{"type":"paragraph","attrs":{"textAlign":"justify"}},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"campo","attrs":{"chave":"local"}},{"type":"text","text":", "},{"type":"campo","attrs":{"chave":"data"}}]},{"type":"paragraph","attrs":{"textAlign":"center"}},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"text","text":"______________________________"}]},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"campo","attrs":{"chave":"proprietario_nome"}}]},{"type":"paragraph","attrs":{"textAlign":"center"}},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"text","text":"______________________________"}]},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"campo","attrs":{"chave":"proprietario_c