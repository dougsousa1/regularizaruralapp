n":"left"},"content":[{"type":"text","text":"Nesse contexto, solicito respeitosamente que, ao término do prazo do Contrato de Arrendamento, cuja data estabelecida é "},{"type":"campo","attrs":{"chave":"data_termino"}},{"type":"text","text":", proceda à desocupação do Imóvel Arrendado, conforme estipulado na cláusula "},{"type":"campo","attrs":{"chave":"clausula_desocupacao"}},{"type":"text","text":" do Contrato de Arrendamento."}]},{"type":"paragraph","attrs":{"textAlign":"left"}},{"type":"paragraph","attrs":{"textAlign":"left"},"content":[{"type":"text","text":"Gostaria de destacar que permaneço à disposição para debater qualquer eventualidade relacionada a este procedimento, visando assegurar uma transição tranquila e ordenada."}]},{"type":"paragraph","attrs":{"textAlign":"left"}},{"type":"paragraph","attrs":{"textAlign":"left"},"content":[{"type":"text","text":"Agradeço antecipadamente pela sua compreensão e colaboração nesta questão."}]},{"type":"paragraph","attrs":{"textAlign":"left"}},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"campo","attrs":{"chave":"data"}}]},{"type":"paragraph","attrs":{"textAlign":"left"}},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"text","text":"___________________________________________________"}]},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"campo","attrs":{"chave":"arrendador_nome"},"marks":[{"type":"bold"}]}]}]}}